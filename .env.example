# Polza.ai API Configuration
# Получите единый API-ключ для 400+ моделей на https://polza.ai/dashboard/api-keys
POLZA_AI_API_KEY=
POLZA_DEFAULT_MODEL=openai/gpt-4o

# GitHub Storage (для сохранения заметок на Vercel без сторонней БД)
# Не обязательно для локальной работы (локально пишется в .data/)
GITHUB_TOKEN=
GITHUB_REPO=username/notehub
GITHUB_BRANCH=main

# Альтернатива: Vercel KV / Upstash Redis (супер-быстро ~15мс, подключается в 1 клик на Vercel)
# Автоматически проставляется Vercel при создании KV базы во вкладке Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=
